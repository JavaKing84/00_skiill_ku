# TechRadar 认证通道凭据模板（复制为 D:\00_skiill_ku\.env 后填写；勿提交真实值）
# Folo：登录 https://app.folo.is → DevTools → Network → 请求头 Cookie 中
#       __Secure-better-auth.session_token 的值
FOLO_SESSION_TOKEN=

# Reddit：https://developers.reddit.com/app-registration 注册 script 应用并等待审批
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# 可选：用户上下文 OAuth2（refresh_token 流程，预留接口；不填则走 client_credentials）
REDDIT_REFRESH_TOKEN=

# 可选：浏览器登录态采集参数（默认即可）
# TECH_RADAR_CDP=http://127.0.0.1:9333
# TECH_RADAR_BROWSER_PROFILE=D:\00_skiill_ku\_browser_profile
# TECH_RADAR_BROWSER_MODE=offscreen   # offscreen | headless（headless 易被 Reddit 识别）
