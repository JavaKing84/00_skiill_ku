# ============================================================
# Skill 库环境变量模板
# 用法：复制为 D:\00_skiill_ku\.env 后填写真实值；.env 已被 .gitignore 排除
# 约定：只写变量名与占位符，任何真实 Key / Token / Cookie 都不得写进本文件
# ============================================================

# ---------- 视频生成（03_video/generative） ----------
# 硅基流动：https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=sk-your_siliconflow_key_here
# 火山方舟（Seedance 直连）：https://console.volcengine.com/ark
VOLC_API_KEY=your_volcengine_ark_key_here
# 阿里百炼（语义检索兜底）
DASHSCOPE_API_KEY=sk-your_dashscope_key_here

# ---------- 视频渲染 ----------
# 自定义 ffmpeg 路径（默认使用系统 PATH 中的 ffmpeg）
# FFMPEG_BIN=C:\ffmpeg\bin\ffmpeg.exe

# ---------- TechRadar 情报源（06_techradar） ----------
# Folo：登录 https://app.folo.is → DevTools → Network → Cookie 中的
#       __Secure-better-auth.session_token
FOLO_SESSION_TOKEN=
# Reddit：https://developers.reddit.com/app-registration
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
# GitHub Issues 采集（只读权限即可）
GITHUB_TOKEN=ghp_your_github_token_here

# ---------- TechRadar 浏览器采集参数（可选，默认即可） ----------
# TECH_RADAR_CDP=http://127.0.0.1:9333
# TECH_RADAR_CDP_PORT=9333
# TECH_RADAR_BROWSER_PROFILE=D:\00_skiill_ku\_browser_profile
# TECH_RADAR_BROWSER_MODE=offscreen      # offscreen | headless
# TECH_RADAR_BROWSER_AUTOCLOSE=1
# TECH_RADAR_DISABLE_BROWSER=0
# TECH_RADAR_PROXY=http://127.0.0.1:7890
# TECH_RADAR_PROXY_PROBE=https://www.gstatic.com/generate_204

# ---------- 通用爬虫 ----------
# SKILLKIT_PROXY=http://127.0.0.1:7890
# SKILLKIT_BROWSER_EXE=D:\00_skiill_ku\01_crawler\runtime\Playwright\chromium-1243\chrome-win64\chrome.exe

# ---------- 60s API（skills/data/60s-api） ----------
# 公开接口无需 Key；如需自建实例可覆盖：
# SIXTY_S_API_BASE=https://60s.viki.moe
